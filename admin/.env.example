# Copy to .env.local (never commit real values)
MONGODB_URI=mongodb://127.0.0.1:27017/tarka
# At least 32 random chars: openssl rand -base64 48
AUTH_SECRET=
# Comma-separated origins allowed to call mutating endpoints (the Vite site / admin UI)
ALLOWED_ORIGINS=http://localhost:5173

# Only used by `npm run seed:owner`
OWNER_NAME=Owner
OWNER_EMAIL=
OWNER_PASSWORD=
